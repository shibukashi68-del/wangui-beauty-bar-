# Local environment template. Copy to .env to configure local development.
# Sensitive values like PGPASSWORD should only be set in .env (which is git-ignored)
# or entered at the secure prompt when running scripts/start-local.ps1.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=wangui_beauty_bar
PORT=3000
NODE_ENV=development

# Public origin(s) of the site, comma-separated. Required when the frontend is
# served from Cloudflare Pages and /api/* is proxied to this backend: the
# forwarded Origin is the Pages domain, which must be trusted for owner
# sign-in, upload, edit and delete. Example:
# SITE_URL=https://salon.pages.dev,https://www.your-domain.co.ke
SITE_URL=

# Comma-separated addresses of reverse proxies whose X-Forwarded-For header is
# trusted for rate limiting. Required when the app sits behind a proxy, or all
# customers share a single rate-limit bucket. Leave empty for direct access.
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2
TRUSTED_PROXIES=

# Optional: Set DATABASE_URL instead of the individual PG* variables above.
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/wangui_beauty_bar

# Owner video publishing (Supabase integration)
# Leave unconfigured for local development unless testing owner uploads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_OWNER_USER_ID=replace-with-owner-auth-uuid
SUPABASE_VIDEO_BUCKET=salon-videos
