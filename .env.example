PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGDATABASE=wangui_beauty_bar
PGPASSWORD=your-postgres-password
ADMIN_PASSWORD=your-strong-admin-password
PORT=3000
NODE_ENV=development
