# Reference only. This project does not automatically load .env files.
# For local setup, run scripts/start-local.ps1 and enter the database
# password at its secure prompt.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGDATABASE=wangui_beauty_bar
PORT=3000
NODE_ENV=development
# Owner video publishing is disabled until these are configured.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_OWNER_USER_ID=replace-with-owner-auth-uuid
SUPABASE_VIDEO_BUCKET=salon-videos
