# Dependencies
node_modules/
.env
.env.*
!.env.example

# Compiled TypeScript output.
# The .ts files in css/ are the source; tsc emits .js beside them.
# Ignoring the emitted JS keeps the repo to sources only — rebuild with
# `npm run build` (or `node ./node_modules/typescript/bin/tsc`).
css/*.js
css/*.js.map

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local logs
*.log

# Continuity
SESSION_HANDOFF.md
.continuity/*
# Continuity decision memory — travels with the repo (runtime state stays ignored)
!.continuity/decisions.jsonl
!.continuity/.gitattributes
!.continuity/SESSION_NOTES.md
!.continuity/INSTRUCTIONS.md
