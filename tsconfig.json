{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmitOnError": false,
    "outDir": "./css",
    "rootDir": "./css",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["css/**/*.ts"],
  "exclude": ["css/**/*.js", "node_modules"]
}